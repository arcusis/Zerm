ranslated","value":"500 אלפיות השנייה"}}}},"5s":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"5 שניות"}}}},"60s":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"60 שניות"}}}},"7 Days":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"7 ימים"}}}},"7 days":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"7 ימים"}}}},"90s":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"90 שניות"}}}},"A New Way to Type":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"דרך חדשה להקליד"}}}},"A Power Mode is a set of dictation settings — model, language, enhancement prompt, auto-send key — that switches itself on when you are in a particular app or on a particular website. Zerm checks the frontmost app first, then the browser's current address, and applies the first mode that matches. If none does, the mode marked as default is used.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מצב עוצמה הוא אוסף הגדרות הכתבה — מודל, שפה, הנחיית שיפור, מקש שליחה אוטומטית — שמופעל מעצמו כשעובדים ביישום מסוים או באתר מסוים. Zerm בודק תחילה את היישום שבחזית, אחר כך את הכתובת הנוכחית בדפדפן, ומחיל את המצב הראשון שמתאים. אם אף מצב אינו מתאים, ייעשה שימוש במצב שמסומן כברירת מחדל."}}}},"A model named %@.bin already exists":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כבר קיים מודל בשם %@.bin"}}}},"A model with this name already exists":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כבר קיים מודל בשם הזה"}}}},"A network error occurred: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אירעה שגיאת רשת: %@"}}}},"A power mode with the name '%@' already exists.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כבר קיים מצב עוצמה בשם '%@'."}}}},"A second, independent key for the same recorder, with its own mode. Handy when you want a hold-to-talk key for quick asides and a toggle key for long dictation. The minus button removes it.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקש עצמאי נוסף לאותו מקליט, עם מצב משלו. שימושי כשרוצים מקש לחיצה-לדיבור להערות קצרות ומקש החלפה להכתבה ארוכה. כפתור המינוס מסיר אותו."}}}},"A small, very fast English model that leaves memory free on 8 GB Macs. Apple Silicon only":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"A small, very fast English model that leaves memory free on 8 GB Macs. Apple Silicon only"}},"he":{"stringUnit":{"state":"translated","value":"מודל אנגלית קטן ומהיר מאוד שמשאיר זיכרון פנוי במחשבי Mac עם 8 GB. ל-Apple Silicon בלבד"}}}},"A speech model is required to start dictating.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נדרש מודל דיבור כדי להתחיל להכתיב."}}}},"AI Enhancement":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שיפור באמצעות AI"}}}},"AI Model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל AI"}}}},"AI Provider":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק AI"}}}},"AI Provider Integration":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חיבור ספק AI"}}}},"AI Request":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בקשת AI"}}}},"AI actions":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פעולות AI"}}}},"AI rewrite unavailable — reading the selection exactly":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניסוח מחדש באמצעות AI אינו זמין — הטקסט הנבחר מוקרא כפי שהוא"}}}},"API Endpoint":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת קצה של API"}}}},"API Endpoint URL":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתובת נקודת הקצה של ה-API"}}}},"API Key":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מפתח API"}}}},"API Key Configuration":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הגדרת מפ