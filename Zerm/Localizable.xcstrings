"}}}},"Reorder":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שינוי סדר"}}}},"Reorder Power Modes":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שינוי סדר מצבי העוצמה"}}}},"Replace":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקור"}}}},"Replacement":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טקסט חלופי"}}}},"Replacement Text":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טקסט חלופי"}}}},"Replacement text":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טקסט חלופי"}}}},"Replacement:":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חלופי:"}}}},"Request Permission":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בקשת הרשאה"}}}},"Request Timeout":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זמן המתנה לבקשה"}}}},"Required":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חובה"}}}},"Required for this provider — Read Aloud will not speak without it. Save & Verify checks the key against the provider before storing it in your macOS Keychain. Switch to Kokoro if you would rather not use an account at all.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נדרש עבור ספק זה — ללא המפתח לא תתבצע הקראה. שמירה ואימות בודקים את המפתח מול הספק לפני שמירתו בצרור המפתחות של macOS. ניתן לעבור ל-Kokoro אם עדיף לעבוד ללא חשבון."}}}},"Rescan for microphones connected since this window opened":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סריקה מחדש של מיקרופונים שחוברו מאז פתיחת החלון"}}}},"Reset":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"איפוס"}}}},"Reset Onboarding":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"איפוס ההיכרות הראשונית"}}}},"Reset Statistics":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"איפוס נתונים סטטיסטיים"}}}},"Reset Statistics?":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לאפס את הנתונים הסטטיסטיים?"}}}},"Reset to default":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"איפוס לברירת המחדל"}}}},"Reset to default sound":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"איפוס לצליל ברירת המחדל"}}}},"Restore Clipboard After Paste":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שחזור הלוח לאחר הדבקה"}}}},"Restore Delay":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השהיית שחזור"}}}},"Resume Delay":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השהיית חידוש השמע"}}}},"Retell":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניסוח מחדש"}}}},"Retell, Summarize, Explain, and Simplify analyze the complete selection with your currently selected on-device language model before speech begins. Read exactly bypasses the language model.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניסוח מחדש, סיכום, הסבר ופישוט מנתחים את כל הטקסט הנבחר באמצעות מודל השפה שנבחר במכשיר לפני תחילת ההקראה. הקראה מדויקת אינה משתמשת במודל השפה."}}}},"Retells selected text before it is spoken. Can be a larger model.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מנסח מחדש את הטקסט הנבחר לפני ההקראה. אפשר להשתמש במודל גדול יותר."}}}},"Retranscribe this audio":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלול מחדש של השמע"}}}},"Retranscription failed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול מחדש נכשל"}}}},"Retranscription successful":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול מחדש הצליח"}}}},"Retry":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניסיון חוזר"}}}},"Retry Download":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry Download"}},"he":{"stringUnit":{"state":"translated","value":"ניסיון הורדה חוזר"}}}},"Retry Last Transcription":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניסיון חוזר של התמלול האחרון"}}}},"Retry failed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הניסיון החוזר נכשל: %@"}}}},"Return (⏎)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Return (⏎)"}}}},"Review system access and decide how long local recordings are kept.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סקירת הרשאות המערכת וקביעת משך השמירה של הקלטות מקומיות."}}}},"Review the system access Zerm needs and the privacy impact of each permission.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סקירת הרשאות המערכת ש-Zerm דורש וההשפעה של כל הרשאה על הפרטיות."}}}},"Rewrite difficult language in simpler terms before speaking.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניסוח מחדש של שפה מורכבת במילים פשוטות יותר לפני ההקראה."}}}},"Rewrites text into natural spoken language using Zerm's on-device model before reading. Fully offline; adds a moment before the first word.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מנסח את הטקסט מחדש לשפה מדוברת טבעית באמצעות המודל של Zerm שעל המכשיר. פועל ללא רשת; מוסיף השהיה קצרה לפני המילה הראשונה."}}}},"Rewrites the awkward parts before speaking: \"https://example.com/a\" becomes a spoken address rather than a string of slashes, \"~/Library\" is read as a path, and acronyms are spelled out. Turn it off if you want the text read literally, character for character.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מנסח מחדש חלקים מסורבלים לפני ההקראה: \"https://example.com/a\" הופך לכתובת מדוברת במקום רצף לוכסנים, \"~/Library\" מוקרא כנתיב וראשי תיבות מאויתים. כבו אפשרות זו כדי שהטקסט יוקרא ככתבו וכלשונו, תו אחר תו."}}}},"Right Command (⌘)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Command ימני (⌘)"}}}},"Right Control (⌃)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Control ימני (⌃)"}}}},"Right Option (⌥)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Option ימני (⌥)"}}}},"Right Shift (⇧)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Shift ימני (⇧)"}}}},"Run":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"רצף"}}}},"Run Cleanup Now":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלת ניקוי כעת"}}}},"Runs the last recording through transcription again, using whatever model and language are selected now. Use it after switching to a more accurate model, or when a transcript came back garbled — the original audio is reused, so you don't have to speak again.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלול מחדש של ההקלטה האחרונה באמצעות המודל והשפה שנבחרו כעת. שימושי לאחר מעבר למודל מדויק יותר או כשהתמלול השתבש; השמע המקורי משמש שוב ואין צורך לדבר מחדש."}}}},"Save":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירה"}}}},"Save & Verify":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירה ואימות"}}}},"Save (skip verification)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירה (ללא אימות)"}}}},"Save Changes":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירת השינויים"}}}},"Save Transcription":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירת התמלול"}}}},"Save as MD":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירה כקובץ MD"}}}},"Save as TXT":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירה כקובץ TXT"}}}},"Save to file":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירה לקובץ"}}}},"Screen Context":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקשר מהמסך"}}}},"Screen Context reads on-screen text for enhancement. Zerm does not save that captured text to disk, but enhancement requests can send it to your configured enhancement provider. Choose an on-device provider to keep it on your Mac.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקשר מהמסך קורא טקסט שמופיע על המסך לצורך שיפור. Zerm אינו שומר את הטקסט שנקלט בדיסק, אך בקשות שיפור יכולות לשלוח אותו לספק השיפור שהוגדר. כדי להשאיר את הטקסט ב-Mac, יש לבחור ספק שפועל במכשיר."}}}},"Screen Recording":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקלטת מסך"}}}},"Screen Recording Access":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"גישה להקלטת מסך"}}}},"Search apps...":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חיפוש יישומים..."}}}},"Search source or spoken text":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חיפוש בטקסט המקורי או המוקרא"}}}},"Search transcriptions":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חיפוש בתמלולים"}}}},"Search transcriptions...":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חיפוש בתמלולים..."}}}},"Select All":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בחירת הכול"}}}},"Select Device":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בחירת התקן"}}}},"Select Language":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בחירת שפה"}}}},"Select Power Mode":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בחירת מצב עוצמה"}}}},"Select Section":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בחירת קטע"}}}},"Select a Whisper ggml .bin model":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a Whisper ggml .bin model"}},"he":{"stringUnit":{"state":"translated","value":"בחירת מודל Whisper בתבנית ggml (קובץ bin)"}}}},"Select a specific input device":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בחירת התקן קלט מסוים"}}}},"Select a transcription to view details":{"localizations":{"he":{"stringUnit":{"state":"tr