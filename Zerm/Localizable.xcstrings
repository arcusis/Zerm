ברים"}}}},"No speech provider selected":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נבחר ספק דיבור"}}}},"No speech was recognized in this file.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא זוהה דיבור בקובץ הזה."}}}},"No text selected":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נבחר טקסט"}}}},"No time saved in the last 12 months":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נחסך זמן ב-12 החודשים האחרונים"}}}},"No time saved in the last 30 days":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נחסך זמן ב-30 הימים האחרונים"}}}},"No time saved in the last 7 days":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נחסך זמן ב-7 הימים האחרונים"}}}},"No time saved with Zerm yet":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עדיין לא נחסך זמן עם Zerm"}}}},"No transcription available":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין תמלול זמין"}}}},"No transcription model selected":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נבחר מודל תמלול"}}}},"No transcription models available. Please connect to a cloud service or download a local model in the AI Models tab.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין מודלי תמלול זמינים. יש להתחבר לשירות ענן או להוריד מודל מקומי במסך המודלים."}}}},"No transcriptions":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין תמלולים"}}}},"No transcriptions yet":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין תמלולים עדיין"}}}},"No trigger words added":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נוספו מילות הפעלה"}}}},"No voice available for %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין קול זמין עבור %@"}}}},"No voice selected":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נבחר קול"}}}},"No voices are available for this provider.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין קולות זמינים עבור ספק זה."}}}},"No websites added":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נוספו אתרים"}}}},"None":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ללא"}}}},"Not Now":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא עכשיו"}}}},"Not Set":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא הוגדר"}}}},"Not a macOS permission — this is simply whether you have picked a key to start dictation with. Without one there is no way to open the recorder except from the menu bar. Configure Shortcut takes you to the Settings pane where you choose it.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זו אינה הרשאת macOS — אלא בדיקה אם נבחר מקש להפעלת ההכתבה. ללא קיצור ניתן לפתוח את המקליט רק משורת התפריטים. הגדרת קיצור תפתח את חלונית ההגדרות המתאימה."}}}},"Not connected to streaming transcription service":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין חיבור לשירות התמלול בזמן אמת"}}}},"Not downloaded":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא הורד"}}}},"Not supported on this Mac":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא נתמך ב-Mac הזה"}}}},"Not verified yet. Verify the endpoint before using this model.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עדיין לא אומת. יש לאמת את נקודת הקצה לפני השימוש במודל."}}}},"Notch":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מגרעת"}}}},"Nothing answered at this URL (HTTP 404/405). Zerm posts audio directly to it, so use the full transcription endpoint, usually ending in /v1/audio/transcriptions.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אף שירות לא ענה בכתובת הזו (HTTP 404/405). Zerm שולח את השמע ישירות אליה, לכן יש להזין את כתובת התמלול המלאה, שבדרך כלל מסתיימת ב-/v1/audio/transcriptions."}}}},"Nothing transcribed — hold a bit longer before releasing":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא תומלל דבר — יש להחזיק את המקש מעט יותר לפני השחרור"}}}},"Nothing transcribed — try again or switch model in AI Models":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא תומלל דבר — יש לנסות שוב או להחליף מודל במסך המודלים"}}}},"OK":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אישור"}}}},"Off":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כבוי"}}}},"On":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מופעל"}}}},"On this Mac":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ב-Mac הזה"}}}},"On timeout":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כשזמן ההמתנה מסתיים"}}}},"On, the model transcribes as you speak and the text appears in the recorder live. Off, it waits for the full recording, which tends to read better on long dictations because it has the whole sentence to work with.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כשהאפשרות מופעלת, המודל מתמלל תוך כדי דיבור והטקסט מופיע במקליט בזמן אמת. כשהיא כבויה, המודל ממתין להקלטה המלאה, ובהכתבות ארוכות התוצאה בדרך כלל טובה יותר כי כל המשפט זמין לו."}}}},"On, words are sent as you speak and appear in the recorder live, so the transcript is ready the moment you stop. Off, the whole recording is uploaded once you finish, which is usually a little more accurate on long or noisy audio.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כשהאפשרות מופעלת, המילים נשלחות תוך כדי דיבור ומופיעות במקליט בזמן אמת, כך שהתמלול מוכן ברגע שמסיימים. כשהיא כבויה, ההקלטה כולה נשלחת בסיום, ובדרך כלל התוצאה מדויקת מעט יותר בשמע ארוך או רועש."}}}},"On-Device":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"במכשיר"}}}},"On-device enhancement uses its own model, separate from dictation and from Read Aloud. Enhancement uses exactly the model marked In use below.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שיפור במכשיר משתמש במודל משלו, נפרד מההכתבה ומההקראה. השיפור משתמש בדיוק במודל שמסומן למטה כ\"בשימוש\"."}}}},"On-device generation failed.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יצירת הטקסט במכשיר נכשלה."}}}},"Only OpenAI-compatible transcription APIs are supported.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only OpenAI-compatible transcription APIs are supported."}},"he":{"stringUnit":{"state":"translated","value":"נתמכים רק ממשקי תמלול שתואמים ל-OpenAI."}}}},"Only OpenAI-compatible transcription APIs are supported. Zerm sends a one-second test recording to verify the endpoint before saving.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נתמכים רק ממשקי תמלול שתואמים OpenAI. לפני השמירה Zerm שולח הקלטת בדיקה של שנייה אחת כדי לאמת את נקודת הקצה."}}}},"Only downloaded models and cloud models with an API key are listed.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מוצגים רק מודלים שהורדו ומודלי ענן שהוגדר עבורם מפתח API."}}}},"Open Enhancement":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת השיפור"}}}},"Open History Window":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת חלון ההיסטוריה"}}}},"Open Main Window":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת החלון הראשי"}}}},"Open Models":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת המודלים"}}}},"Open Settings":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת ההגדרות"}}}},"Open System Settings":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת הגדרות המערכת"}}}},"Open Transcript":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת התמלול"}}}},"Open history from anywhere with a global shortcut":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת ההיסטוריה מכל מקום בעזרת קיצור מקשים כללי"}}}},"OpenAI Compatible":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תואם OpenAI"}}}},"OpenAI's current speech-to-text model with prompt and keyword support":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל המרת הדיבור לטקסט העדכני של OpenAI, עם תמיכה בהנחיה ובמילות מפתח"}}}},"Opening installer…":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פותח את המתקין…"}}}},"Opens a small panel from anywhere so you can add a word or a replacement without coming back to this window. Handy the moment a transcript gets a name wrong — fix it once and later dictations get it right.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פותח חלונית קטנה מכל מקום כדי להוסיף מילה או החלפה בלי לחזור לחלון הזה. שימושי ברגע שתמלול משבש שם — מתקנים פעם אחת וההכתבות הבאות יהיו נכונות."}}}},"Opens the folder holding the debug log so you can read it or attach it to a bug report. Have a look through it before sending it on.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת התיקייה שמכילה את יומן ניפוי השגיאות כדי לקרוא אותו או לצרפו לדיווח תקלה. מומלץ לעיין בו לפני השליחה."}}}},"Optimizing model for your device...":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מבצע אופטימיזציה של המודל למכשיר..."}}}},"Options":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אפשרויות"}}}},"Order decides which mode wins when more than one could match — the topmost match is applied. Put your most specific modes above the broader ones.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הסדר קובע איזה מצב גובר כשכמה מצבים מתאימים — המצב המתאים העליון ביותר מוחל. כדאי למקם את המצבים הספציפיים ביותר מעל הכלליים יותר."}}}},"Original":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקורי"}}}},"Original Text":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טקסט מקורי"}}}},"Original text (use commas for multiple)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טקסט מקורי (אפשר להפריד כמה בפסיקים)"}}}},"Original:":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקורי:"}}}},"Output":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פלט"}}}},"Output Format":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סגנון הפלט"}}}},"Output format, formatting, VAD and filler words":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Output format, formatting, VAD and filler words"}},"he":{"stringUnit":{"state":"translated","value":"תבנית פלט, עיצוב, זיהוי דיבור ומילות מילוי"}}}},"Parakeet Unified is not downloaded. Download it again in Models.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Parakeet Unified is not downloaded. Download it again in Models."}},"he":{"stringUnit":{"state":"translated","value":"Parakeet Unified לא הורד. יש להוריד אותו שוב במסך המודלים."}}}},"Parakeet needs a one-time update download. Connect to the internet and try again.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Parakeet needs a one-time update download. Connect to the internet and try again."}},"he":{"stringUnit":{"state":"translated","value":"Parakeet צריך הורדת עדכון חד־פעמית. יש להתחבר לאינטרנט ולנסות שוב."}}}},"Paste API key":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבקת מפתח API"}}}},"Paste Last Transcription (Enhanced)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבקת התמלול האחרון (משופר)"}}}},"Paste Last Transcription (Original)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבקת התמלול האחרון (מקורי)"}}}},"Paste Options":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אפשרויות הדבקה"}}}},"Paste immediately, then improve the text in place when the app allows a direct edit. Otherwise the raw text stays and the refinement is kept in History.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבקה מיידית ולאחר מכן שיפור הטקסט במקומו כשהיישום מאפשר עריכה ישירה. אחרת הטקסט הגולמי נשאר והגרסה המשופרת נשמרת בהיסטוריה."}}}},"Paste immediately, then improve the text in place. In apps that do not expose an exact editable text range to macOS, Zerm waits and pastes the refined text once.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבקה מיידית ולאחר מכן שיפור הטקסט במקומו. ביישומים שאינם חושפים ל-macOS טווח טקסט מדויק וניתן לעריכה, Zerm ממתין ומדביק את הטקסט המשופר פעם אחת."}}}},"Paste immediately. No AI.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבקה מיידית. ללא AI."}}}},"Pastes the AI-enhanced version of your most recent dictation again. Nothing is re-sent to the provider — this replays the result that was already produced.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבקה חוזרת של הגרסה המשופרת באמצעות AI של ההכתבה האחרונה. דבר אינו נשלח שוב לספק; נעשה שימוש בתוצאה שכבר הופקה."}}}},"Pastes the raw transcript of your most recent dictation again, exactly as the model heard it, with no AI enhancement. Useful when a paste landed in the wrong window, or when the enhanced version changed something you wanted kept.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבקה חוזרת של התמלול הגולמי מההכתבה האחרונה, בדיוק כפי שהמודל שמע אותו וללא שיפור AI. שימושי כשהטקסט הודבק בחלון הלא נכון או כשהשיפור שינה דבר שרצית לשמור."}}}},"Pasting works by putting the transcript on the clipboard, which overwrites whatever you had copied. Turn this on to put your previous clipboard contents back once the paste has landed.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההדבקה מציבה את התמלול בלוח ומחליפה את מה שהועתק קודם. אפשר להפעיל זאת כדי לשחזר את תוכן הלוח הקודם לאחר שההדבקה הסתיימה."}}}},"Pause":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השהיה"}}}},"Performance Analysis":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניתוח ביצועים"}}}},"Permanently clears every recorded day on the Dashboard, along with the Read Aloud totals. Your transcripts and audio recordings are left alone — those have their own controls above. This cannot be undone, and the numbers do not come back: they are not rebuilt from your transcripts afterwards, even if you have kept every one of them.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מחיקה לצמיתות של כל הימים המתועדים בלוח הבקרה ושל סיכומי ההקראה. התמלולים והקלטות השמע נשארים ללא שינוי. אי אפשר לבטל את הפעולה, והנתונים אינם נבנים מחדש מהתמלולים."}}}},"Permission looks granted — fully quit Zerm (Cmd+Q) and reopen to finish enabling Screen Recording":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נראה שההרשאה ניתנה — יש לסגור את Zerm לחלוטין (Cmd+Q) ולפתוח מחדש כדי להשלים את הפעלת הקלטת המסך"}}}},"Permissions":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הרשאות"}}}},"Permissions & Privacy":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הרשאות ופרטיות"}}}},"Pick the one microphone Zerm always records from. It stays selected even when macOS switches its own input, which keeps transcripts consistent if you have several devices connected. If the chosen device is unplugged, recording falls back to the system default.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בחירת המיקרופון שממנו Zerm תמיד מקליט. הוא נשאר נבחר גם כש-macOS מחליף קלט. אם ההתקן שנבחר מנותק, ההקלטה חוזרת לברירת המחדל של המערכת."}}}},"Picked for this Mac: %@":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Picked for this Mac: %@"}},"he":{"stringUnit":{"state":"translated","value":"נבחרו עבור ה-Mac הזה: %@"}}}},"Plain Text (.txt)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טקסט פשוט · TXT"}}}},"Play":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלה"}}}},"Play from here":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלה מנקודה זו"}}}},"Playback rate, from half speed to double. Around 1.3× is a common choice for skimming long text; drop below 1× for dense material or an unfamiliar language.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קצב ההשמעה, מחצי מהירות ועד מהירות כפולה. מהירות של כ-1.3× מתאימה לריפרוף על טקסט ארוך; לחומר צפוף או לשפה לא מוכרת מומלץ לרדת מתחת ל-1×."}}}},"Playback speed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מהירות השמעה"}}}},"Plays a short sound when recording starts and another when it stops, so you know the recorder is listening without looking at it. Expand to choose your own sounds.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השמעת צליל קצר בתחילת ההקלטה וצליל נוסף בסיומה, כדי לדעת שהמקליט פועל בלי להסתכל. אפשר להרחיב כדי לבחור צלילים מותאמים."}}}},"Please fix the validation errors before saving.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יש לתקן את שגיאות האימות לפני השמירה."}}}},"Please restart the application. If the problem persists, contact support.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יש להפעיל מחדש את היישום. אם הבעיה נמשכת, יש לפנות לתמיכה."}}}},"Power Mode":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מצב עוצמה"}}}},"Power Mode Still Active":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מצב העוצמה עדיין פעיל"}}}},"Power Modes":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מצבי עוצמה"}}}},"Power mode name cannot be empty.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שם מצב העוצמה לא יכול להיות ריק."}}}},"Preparing audio…":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מכין את השמע…"}}}},"Preparing…":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מכין…"}}}},"Preset":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הגדרה מוכנה"}}}},"Press ESC again to cancel recording":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יש ללחוץ שוב על ESC כדי לבטל את ההקלטה"}}}},"Press this key with text selected and Zerm reads it out; press it again to stop. Pick a key you do not use for dictation — if the two clash, one press would try to do both.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לחצו על מקש זה כאשר טקסט נבחר ו-Zerm יקריא אותו; לחצו שוב כדי לעצור. בחרו מקש שאינו משמש להכתבה — אם שני הקיצורים זהים, לחיצה אחת תנסה להפעיל את שניהם."}}}},"Press your shortcut key":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לחצו על מקש הקיצור"}}}},"Press your shortcut key again":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לחצו שוב על מקש הקיצור"}}}},"Preview voice":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תצוגה מקדימה של הקול"}}}},"Prewarm model (Experimental)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חימום מוקדם של המודל (ניסיוני)"}}}},"Prioritized":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לפי עדיפות"}}}},"Prioritized Devices":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התקנים מועדפים"}}}},"Privacy":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פרטיות"}}}},"Private, on-device. No API key.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פרטי ועל המכשיר. ללא מפתח API."}}}},"Processor":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מעבד"}}}},"Prompt":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הנחיה"}}}},"Prompt Name":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שם ההנחיה"}}}},"Provider":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק"}}}},"Provider error %lld: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שגיאת ספק %lld: %@"}}}},"Provider verification failed (HTTP %lld): %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות הספק נכשל (HTTP %lld): %@"}}}},"Provider verification failed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות הספק נכשל: %@"}}}},"Punctuation":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פיסוק"}}}},"Push to Talk":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לחיצה לדיבור"}}}},"Puts a single space at the end of every pasted transcript, so you can dictate one sentence after another without the words running together. Turn it off when you dictate into fields where a trailing space matters, such as a search box or a file name.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מוסיף רווח יחיד בסוף כל תמלול שמודבק, כך שאפשר להכתיב משפט אחרי משפט בלי שהמילים יתחברו. כדאי לכבות כשמכתיבים לשדות שבהם רווח בסוף משנה, כמו תיבת חיפוש או שם קובץ."}}}},"Quantized version of Large v3 Turbo, faster with slightly lower accuracy":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"גרסה דחוסה של Large v3 Turbo, מהירה יותר בדיוק נמוך מעט"}}}},"Quick Access":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"גישה מהירה"}}}},"Quick Add shortcut and other dictionary settings":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קיצור הדרך להוספה מהירה והגדרות נוספות של המילון"}}}},"Quick Add to Dictionary":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הוספה מהירה למילון"}}}},"Quickly enable or disable AI enhancement while recording. Available only when Zerm is running and the recorder is visible.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלה או השבתה מהירה של שיפור AI בזמן הקלטה. זמין רק כאשר Zerm פועל והמקליט מוצג."}}}},"Quit":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יציאה"}}}},"Quit Zerm":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יציאה מ-Zerm"}}}},"Quit Zerm to Finish":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סגירת Zerm להשלמה"}}}},"RAM":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זיכרון RAM"}}}},"Re-enhance":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שיפור מחדש"}}}},"Re-enhance with selected prompt":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שיפור מחדש עם ההנחיה שנבחרה"}}}},"Re-enhancement failed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השיפור מחדש נכשל"}}}},"Re-enhancement successful":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השיפור מחדש הצליח"}}}},"Re-transcribe":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלול מחדש"}}}},"Re-transcribe failed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול מחדש נכשל: %@"}}}},"Re-transcribed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול בוצע מחדש"}}}},"Read Aloud":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקראה בקול"}}}},"Read Aloud History":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"היסטוריית הקראה"}}}},"Read Aloud default":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ברירת המחדל להקראה"}}}},"Read Aloud failed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההקראה בקול נכשלה: %@"}}}},"Read Aloud trigger key":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקש הפעלת הקראה בקול"}}}},"Read Aloud voice":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קול ההקראה"}}}},"Read Aloud voice provider":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק הקול להקראה"}}}},"Read Selected Text":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקראת הטקסט הנבחר"}}}},"Read exactly":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקראה מדויקת"}}}},"Read more about custom local models":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read more about custom local models"}},"he":{"stringUnit":{"state":"translated","value":"מידע נוסף על מודלים מקומיים מותאמים"}}}},"Reading mode":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מצב הקראה"}}}},"Reading speed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מהירות הקראה"}}}},"Reading speed: %@ times normal":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מהירות הקראה: פי %@ מהמהירות הרגילה"}}}},"Reads the text visible on screen and passes it to the AI along with your transcript. Used in Enhanced output only. Needs Screen Recording permission, and means on-screen text is sent to your enhancement provider.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קורא את הטקסט שמוצג על המסך ומעביר אותו ל-AI יחד עם התמלול. פועל רק בפלט משופר. דורש הרשאת הקלטת מסך, ומשמעות הדבר שטקסט מהמסך נשלח לספק השיפור."}}}},"Ready":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מוכן"}}}},"Real-time":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בזמן אמת"}}}},"Recommended":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recommended"}},"he":{"stringUnit":{"state":"translated","value":"מומלצים"}}}},"Recommended picks the best English, multilingual and Hebrew models this Mac runs comfortably. Local models run on this Mac with no network and no per-word cost. Cloud models are usually more accurate but send your audio to a provider and need an API key. Custom is for your own OpenAI-compatible endpoint.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recommended picks the best English, multilingual and Hebrew models this Mac runs comfortably. Local models run on this Mac with no network and no per-word cost. Cloud models are usually more accurate but send your audio to a provider and need an API key. Custom is for your own OpenAI-compatible endpoint."}},"he":{"stringUnit":{"state":"translated","value":"מומלצים מציג את המודלים הטובים ביותר לאנגלית, לשפות רבות ולעברית שה-Mac הזה מריץ בנוחות. מודלים מקומיים פועלים על ה-Mac ללא רשת וללא עלות לכל מילה. מודלי ענן מדויקים לרוב יותר, אך שולחים את השמע לספק ודורשים מפתח API. מותאם אישית מיועד לנקודת קצה משלך שתואמת ל-OpenAI."}}}},"Recorder Style":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סגנון המקליט"}}}},"Recording Failed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההקלטה נכשלה: %@"}}}},"Recording Feedback":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"משוב הקלטה"}}}},"Recording failed to start":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן היה להתחיל את ההקלטה"}}}},"Recording produced no audio — the microphone may have dropped. Try again.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההקלטה לא הפיקה שמע — ייתכן שהמיקרופון התנתק. יש לנסות שוב."}}}},"Recording saved — a newer take started before this one finished. Retry from History.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההקלטה נשמרה — הקלטה חדשה התחילה לפני שזו הסתיימה. אפשר לנסות שוב מההיסטוריה."}}}},"Recording saved — the recorder closed before transcription. Retry from History.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההקלטה נשמרה — המקליט נסגר לפני התמלול. אפשר לנסות שוב מההיסטוריה."}}}},"Recording saved — transcription was cancelled. Retry from History.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההקלטה נשמרה — התמלול בוטל. אפשר לנסות שוב מההיסטוריה."}}}},"Recording stopped — microphone dropped":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההקלטה נעצרה — המיקרופון התנתק"}}}},"Refresh":{"localizations":{"he":{"stringUnit":{"state":"trans