s":{"he":{"stringUnit":{"state":"translated","value":"הצגת תצוגה מקדימה של הטקסט בזמן אמת"}}}},"Show data table":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגת טבלת נתונים"}}}},"Show in Finder":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגה ב-Finder"}}}},"Shows occasional in-app notes about new features and known issues. Turn it off for a completely quiet app.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגת הודעות מזדמנות בתוך היישום על תכונות חדשות ובעיות ידועות. אפשר לכבות לקבלת יישום שקט לחלוטין."}}}},"Shows the welcome and setup screens again the next time you launch Zerm. Your settings, prompts and history are left alone.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגה מחדש של מסכי הפתיחה וההגדרה בהפעלה הבאה של Zerm. ההגדרות, ההנחיות וההיסטוריה נשארות ללא שינוי."}}}},"Silences your Mac's output for the length of the recording, then restores the previous volume. Stops music or a video call leaking into the microphone and being transcribed as speech.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השתקת פלט השמע של ה-Mac למשך ההקלטה ולאחר מכן שחזור העוצמה הקודמת. כך מוזיקה או שיחת וידאו לא יזלגו למיקרופון ויתומללו כדיבור."}}}},"Simplify":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פישוט"}}}},"Skip Tour":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"דילוג על הסיור"}}}},"Skip for now":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"דילוג בינתיים"}}}},"Skip short transcriptions":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"דילוג על תמלולים קצרים"}}}},"Skip the test request and save directly. Use when your gateway rejects the verification probe.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירה ישירה בלי בקשת הבדיקה. מתאים כששער ה-API דוחה את בקשת האימות."}}}},"Skips the mute for wired headphones, Bluetooth headsets and USB headsets that include an input. USB speakers or DACs, HDMI, AirPlay, and built-in or external speakers are treated as unsafe and still mute.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא משתיק אוזניות חוטיות, אוזניות Bluetooth או אוזניות USB הכוללות קלט. רמקולי USB, ממירי DAC, ‏HDMI, ‏AirPlay ורמקולים מובנים או חיצוניים נחשבים לא בטוחים ולכן מושתקים."}}}},"Small Read Aloud fallback. Do not use for enhancement.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חלופה קטנה להקראה. לא מתאים לשיפור."}}}},"Smaller opt-in. Matches the default on English cleanup, but translates mixed-language dictation instead of preserving it.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חלופה קטנה יותר. משתווה לברירת המחדל בניקוי טקסט באנגלית, אבל מתרגם הכתבה בשפות מעורבות במקום לשמור עליה."}}}},"Smart reading":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקראה חכמה"}}}},"Smart text cleanup":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניקוי טקסט חכם"}}}},"Some parts of the file could not be transcribed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן היה לתמלל חלקים מהקובץ: %@"}}}},"Soniox transcription failed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול ב-Soniox נכשל"}}}},"Soniox transcription model v5 with high accuracy and automatic switching between languages, including Hebrew and English":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל התמלול v5 של Soniox, מדויק מאוד ועובר אוטומטית בין שפות, כולל עברית ואנגלית"}}}},"Sort alphabetically":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מיון לפי סדר האלף-בית"}}}},"Sort by original":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מיון לפי הטקסט המקורי"}}}},"Sort by replacement":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מיון לפי הטקסט החלופי"}}}},"Sound Feedback":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"משוב צלילי"}}}},"Space":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"רווח"}}}},"Speak":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקראה"}}}},"Speak Selected Content":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקראת תוכן נבחר"}}}},"Speak a shorter version containing the important points.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקראת גרסה קצרה יותר הכוללת את הנקודות החשובות."}}}},"Speak something":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אמרו משהו"}}}},"Speak the selection without AI rewriting.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקראת הטקסט הנבחר ללא ניסוח מחדש באמצעות AI."}}}},"Speak while testing to confirm your mic is picking up audio.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יש לדבר בזמן הבדיקה כדי לוודא שהמיקרופון קולט שמע."}}}},"Speaker %lld":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"דובר %lld"}}}},"Speaker labels":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Speaker labels"}},"he":{"stringUnit":{"state":"translated","value":"זיהוי דוברים"}}}},"Speaker name":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שם הדובר"}}}},"Speakers":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"דוברים"}}}},"Speakers could not be identified, so this transcript has no speaker labels. The speaker model downloads on first use; check your connection and retry the file.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן היה לזהות את הדוברים, ולכן בתמלול אין תוויות דוברים. מודל זיהוי הדוברים מורד בשימוש הראשון; יש לבדוק את החיבור לאינטרנט ולנסות שוב את הקובץ."}}}},"Speakers detected automatically":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מספר הדוברים מזוהה אוטומטית"}}}},"Speaking…":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקריא…"}}}},"Speaks a sample sentence with the current provider, voice and speed, using the same recorder widget a real trigger uses. A quick way to check your key and settings work before relying on them.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקריא משפט לדוגמה באמצעות הספק, הקול והמהירות הנוכחיים, באותו יישומון הקלטה שמשמש הפעלה אמיתית. זו דרך מהירה לוודא שהמפתח וההגדרות פועלים לפני שמסתמכים עליהם."}}}},"Specialized English-only medical transcription model optimized for clinical environments":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל ייעודי לתמלול רפואי באנגלית בלבד, מותאם לסביבה קלינית"}}}},"Speech":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"דיבור"}}}},"SpeechAnalyzer requires macOS 26 or later.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"SpeechAnalyzer דורש macOS 26 ומעלה."}}}},"Speechmatics enhanced accuracy transcription with real-time streaming and 50+ language support":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלול בדיוק משופר של Speechmatics, בזמן אמת ובלמעלה מ-50 שפות"}}}},"Speed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מהירות"}}}},"Start Sound":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"צליל התחלה"}}}},"Start or stop the Zerm mini recorder for voice transcription.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלה או עצירה של המקליט המוקטן של Zerm לתמלול קולי."}}}},"Start with Template":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התחלה מתבנית"}}}},"Start your first recording to unlock value insights.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התחילו הקלטה ראשונה כדי לראות כמה זמן Zerm חוסך לכם."}}}},"Starts Zerm automatically when you log in, so your dictation shortcut works without opening the app first.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלה אוטומטית של Zerm בעת הכניסה למערכת, כך שקיצור ההכתבה יעבוד בלי לפתוח תחילה את היישום."}}}},"Starts and stops recording with the middle mouse button — the scroll wheel click — so you can dictate without reaching for the keyboard. Leave it off if you use middle-click to open links in tabs.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התחלה ועצירה של הקלטה באמצעות כפתור העכבר האמצעי, כלומר לחיצה על גלגלת הגלילה. יש להשאיר כבוי אם הלחיצה האמצעית משמשת לפתיחת קישורים בכרטיסיות."}}}},"Stop":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עצירה"}}}},"Stop Read Aloud":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עצירת ההקראה"}}}},"Stop Sound":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"צליל עצירה"}}}},"Storage":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אחסון"}}}},"Storage & Backup":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אחסון וגיבוי"}}}},"Storage Warning":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אזהרת אחסון"}}}},"Streaming":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Streaming"}},"he":{"stringUnit":{"state":"translated","value":"סטרימינג"}}}},"Streaming connection failed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"החיבור לתמלול בזמן אמת נכשל: %@"}}}},"Streaming provider error: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שגיאת ספק בתמלול בזמן אמת: %@"}}}},"Streaming provider reported an error":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק התמלול בזמן אמת דיווח על שגיאה"}}}},"Streaming server error: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שגיאת שרת בתמלול בזמן אמת: %@"}}}},"Streaming transcription is not supported for %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלול בזמן אמת אינו נתמך עבור %@"}}}},"Streaming transcription returned no text":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול בזמן אמת לא החזיר טקסט"}}}},"Streaming transcription timed out waiting for final result":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זמן ההמתנה לתוצאה הסופית של התמלול בזמן אמת עבר"}}}},"SubRip Subtitles (.srt)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתוביות SubRip · SRT"}}}},"Suggested":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצעות"}}}},"Summarize":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סיכום"}}}},"Summary":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סיכום"}}}},"Switch Enhancement Prompt":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"החלפת הנחיית השיפור"}}}},"Switch between your saved prompts using ⌘1 through ⌘0 to activate the corresponding prompt in the order they are saved. Available only when Zerm is running and the recorder is visible.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מעבר בין ההנחיות השמורות באמצעות ⌘1 עד ⌘0, לפי סדר שמירתן. זמין רק כאשר Zerm פועל והמקליט מוצג."}}}},"Switched to: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקור הקלט הוחלף: %@"}}}},"System":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מערכת"}}}},"System Default":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ברירת המחדל של המערכת"}}}},"System Information":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מידע מערכת"}}}},"System Prompt":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הנחיית מערכת"}}}},"Test":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בדיקה"}}}},"Test Microphone":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בדיקת מיקרופון"}}}},"Test my mic":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בדיקת המיקרופון שלי"}}}},"Test sound":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בדיקת הצליל"}}}},"Text":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טקסט"}}}},"Text Formatting":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עיצוב טקסט"}}}},"That file contains no audio.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקובץ אינו מכיל שמע."}}}},"The API request failed with status code %lld: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בקשת ה-API נכשלה עם קוד סטטוס %1$lld: %2$@"}}}},"The API returned an empty or invalid response.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ה-API החזיר תשובה ריקה או לא תקינה."}}}},"The analog jack is treated as speakers until you confirm wired headphones for this attempt. Zerm asks again for every Read Aloud attempt, and whenever the output changes.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השקע האנלוגי נחשב לרמקולים עד שמאשרים אוזניות חוטיות לניסיון הנוכחי. Zerm מבקש אישור מחדש בכל ניסיון הקראה ובכל שינוי של פלט השמע."}}}},"The app '%@' is already configured in the '%@' power mode.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"היישום '%1$@' כבר מוגדר במצב העוצמה '%2$@'."}}}},"The audio file is invalid or corrupted":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קובץ השמע אינו תקין או פגום"}}}},"The audio file to transcribe could not be found.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קובץ השמע לתמלול לא נמצא."}}}},"The audio format is not supported":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תבנית השמע אינה נתמכת"}}}},"The audio in this file could not be read.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן לקרוא את השמע בקובץ הזה."}}}},"The cloud service could not be reached. Check your connection and retry.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן להתחבר לשירות הענן. יש לבדוק את החיבור לאינטרנט ולנסות שוב."}}}},"The core transcription engine failed.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מנוע התמלול נכשל."}}}},"The downloaded Core ML model archive might be corrupted. Try deleting the model and downloading it again. Check available disk space.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ייתכן שארכיון מודל Core ML שהורד פגום. כדאי למחוק את המודל ולהוריד אותו שוב, ולבדוק שיש מספיק מקום פנוי בדיסק."}}}},"The downloaded file did not match its published checksum and was discarded. Try again.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The downloaded file did not match its published checksum and was discarded. Try again."}},"he":{"stringUnit":{"state":"translated","value":"הקובץ שהורד לא תאם לסכום הביקורת שפורסם ולכן נמחק. יש לנסות שוב."}}}},"The emoji \"%@\" is currently used by one or more Power Modes and cannot be removed.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"האמוג'י \"%@\" משמש כרגע מצב עוצמה אחד או יותר ולכן לא ניתן להסיר אותו."}}}},"The endpoint URL is not valid.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתובת נקודת הקצה אינה תקינה."}}}},"The endpoint answered, but not with a transcription. Expected JSON with a \"text\" field or plain text.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה ענתה, אבל לא עם תמלול. הציפייה היא ל-JSON עם שדה \"text\" או לטקסט רגיל."}}}},"The endpoint does not accept multipart audio uploads (HTTP 415). It may not be OpenAI-compatible.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה לא מקבלת העלאת שמע מסוג multipart (HTTP 415). ייתכן שהיא אינה תואמת OpenAI."}}}},"The endpoint had a server error (HTTP %lld). Try again later.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אירעה שגיאת שרת בנקודת הקצה (HTTP %lld). כדאי לנסות שוב מאוחר יותר."}}}},"The endpoint is rate limiting requests (HTTP 429). Try again shortly.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה מגבילה את קצב הבקשות (HTTP 429). כדאי לנסות שוב בעוד רגע."}}}},"The endpoint rejected the API key (HTTP 401/403). Check the key and that it has access to transcription.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה דחתה את מפתח ה-API (HTTP 401/403). יש לבדוק את המפתח ושיש לו הרשאה לתמלול."}}}},"The endpoint rejected the request. Check the model name and language. Details: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה דחתה את הבקשה. יש לבדוק את שם המודל ואת השפה. פרטים: %@"}}}},"The imported settings file (version %@) is from a different version than your application (version %@). Proceeding with import, but be aware of potential incompatibilities.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קובץ ההגדרות המיובא (גרסה %1$@) נוצר בגרסה שונה מהגרסה של היישום (גרסה %2$@). הייבוא ימשיך, אך ייתכנו אי-התאמות."}}}},"The instructions the AI follows in this mode — this is what makes a Power Mode feel tailored. Pick your email prompt for the mail app, a terse one for chat, a note-taking one for your editor.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההוראות שה-AI מבצע במצב הזה — זה מה שהופך מצב עוצמה למותאם אישית. אפשר לבחור הנחיית אימייל ליישום הדואר, הנחיה תמציתית לצ'אט והנחיה לרישום הערות לעורך."}}}},"The key that opens the recorder and starts dictation. Toggle starts on one press and stops on the next; Push to Talk records only while the key is held; Hybrid does both — a quick tap toggles, holding for longer than half a second records until you let go. Choose Custom to record any key combination you like.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המקש שפותח את המקליט ומתחיל הכתבה. מצב החלפה מתחיל בלחיצה אחת ועוצר בבאה; לחיצה לדיבור מקליטה רק כל עוד המקש מוחזק; מצב משולב עושה את שניהם. בחירה במותאם מאפשרת להקליט כל צירוף מקשים."}}}},"The language you speak when dictating. Naming it is more accurate than Auto-detect, which can guess wrong on a short phrase or a sentence that mixes languages. Set a different language for particular apps with a Power Mode.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השפה שבה מדברים בזמן הכתבה. בחירת שפה מסוימת מדויקת יותר מזיהוי אוטומטי, שעלול לטעות בביטוי קצר או במשפט שמשלב כמה שפות. אפשר להגדיר שפה אחרת ליישומים מסוימים באמצעות מצב עוצמה."}}}},"The language you speak while this mode is active. \"Use global setting\" follows the language chosen in Dictation Models.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השפה שבה מדברים כשהמצב הזה פעיל. \"שימוש בהגדרה הכללית\" עוקב אחרי השפה שנבחרה במודלי ההכתבה."}}}},"The local model could not prepare a reliable spoken version. Try again or choose Read exactly.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל המקומי לא הצליח להכין גרסה אמינה להקראה. יש לנסות שוב או לבחור בהקראה מדויקת."}}}},"The microphone audio file could not be written (status %lld).":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן היה לכתוב את קובץ השמע של המיקרופון (מצב %lld)."}}}},"The microphone macOS is currently set to use. Zerm follows it, so changing the input in System Settings or plugging in a headset changes what Zerm records from. Switch to Custom Device if you want it pinned instead.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המיקרופון ש-macOS מוגדר להשתמש בו כעת. Zerm עוקב אחריו, ולכן שינוי הקלט בהגדרות המערכת או חיבור אוזניות משנה את מקור ההקלטה. יש לעבור להתקן מותאם כדי לקבע מקור."}}}},"The model above works out the language on its own, so there is nothing to choose here. Switch to a different model if you need to pin one language.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל שלמעלה מזהה את השפה בעצמו, ולכן אין כאן מה לבחור. כדי לקבע שפה אחת יש לעבור למודל אחר."}}}},"The model provider is not supported by this service.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק המודל אינו נתמך בשירות הזה."}}}},"The model that transcribes your speech unless a Power Mode says otherwise. Choose a different one with Set as Default on any card below.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The model that transcribes your speech unless a Power Mode says otherwise. Choose a different one with Set as Default on any card below."}},"he":{"stringUnit":{"state":"translated","value":"המודל שמתמלל את הדיבור, אלא אם מצב עוצמה קובע אחרת. לבחירת מודל אחר יש ללחוץ על ״הגדרה כברירת מחדל״ באחד הכרטיסים שלמטה."}}}},"The most accurate Hebrew model, fine-tuned by ivrit.ai. Slower and needs a Mac with 24 GB of memory or more":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The most accurate Hebrew model, fine-tuned by ivrit.ai. Slower and needs a Mac with 24 GB of memory or more"}},"he":{"stringUnit":{"state":"translated","value":"מודל העברית המדויק ביותר, שאומן על ידי ivrit.ai. איטי יותר ודורש Mac עם 24 GB זיכרון לפחות"}}}},"The name and icon you will see on the prompt grid and in the recorder when switching prompts mid-dictation. The description is a reminder for you — it is not sent to the AI.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השם והסמל שיוצגו ברשת ההנחיות ובמקליט בעת החלפת הנחיה באמצע הכתבה. התיאור הוא תזכורת בלבד — הוא אינו נשלח ל-AI."}}}},"The offline voice model. Download it once and Read Aloud works with no account, no API key and no text ever leaving your Mac — including on a plane. Deleting it frees the disk space; you can download it again later.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל הקול המקומי. מורידים אותו פעם אחת וההקראה פועלת ללא חשבון, ללא מפתח API ומבלי שהטקסט יצא מה-Mac — גם במטוס. מחיקתו מפנה מקום בדיסק וניתן להורידו שוב בהמשך."}}}},"The on-device Kokoro model isn't downloaded yet. Download it in Read Aloud settings.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל Kokoro שעל המכשיר עדיין לא הורד. יש להוריד אותו בהגדרות הקראה בקול."}}}},"The on-device model isn't downloaded yet. Download it in Enhancement or Read Aloud settings.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל שבמכשיר עדיין לא הורד. אפשר להוריד אותו בהגדרות השיפור או ההקראה."}}}},"The one permission Zerm cannot work without — no microphone access means no audio to transcribe. macOS only asks once, so if you declined the first time you have to grant it in System Settings under Privacy & Security › Microphone.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm אינו יכול לפעול ללא הרשאה זו — בלי גישה למיקרופון אין שמע לתמלול. macOS מבקשת את ההרשאה פעם אחת בלבד; אם היא נדחתה, יש להעניק אותה בהגדרות המערכת תחת פרטיות ואבטחה › מיקרופון."}}}},"The provided API key is invalid.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מפתח ה-API שהוזן אינו תקין."}}}},"The provider returned no audio.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הספק לא החזיר שמע."}}}},"The provider this prompt uses. \"Use global setting\" follows the provider selected in Enhancement. A Power Mode that sets its own provider takes precedence.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הספק שההנחיה הזו משתמשת בו. \"שימוש בהגדרה הכללית\" עוקב אחרי הספק שנבחר במסך השיפור. מצב עוצמה שמגדיר ספק משלו גובר עליה."}}}},"The recording file could not be opened. If the audio is still in History, retry from there.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן היה לפתוח את קובץ ההקלטה. אם השמע עדיין מופיע בהיסטוריה, אפשר לנסות שוב משם."}}}},"The saved transcript for this recording could not be read.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן לקרוא את התמלול השמור של ההקלטה הזו."}}}},"The selected Apple voice is no longer installed.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקול שנבחר של Apple אינו מותקן עוד."}}}},"The selected language is not supported by SpeechAnalyzer.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השפה שנבחרה אינה נתמכת ב-SpeechAnalyzer."}}}},"The settings export operation was canceled.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ייצוא ההגדרות בוטל."}}}},"The settings import operation was canceled.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ייבוא ההגדרות בוטל."}}}},"The specific model from that provider. Smaller models return faster and cost less, which suits quick messages; larger ones handle long or carefully worded text better.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל הספציפי של הספק. מודלים קטנים מחזירים תשובה מהר יותר ועולים פחות, ומתאימים להודעות קצרות; מודלים גדולים מתמודדים טוב יותר עם טקסט ארוך או מנוסח בקפידה."}}}},"The transcription language is automatically detected by the model.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל מזהה את שפת התמלול באופן אוטומטי."}}}},"The transcription model used while this mode is active. \"Use global setting\" always follows the model selected in Dictation Models.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל התמלול שמשמש כשהמצב הזה פעיל. \"שימוש בהגדרה הכללית\" תמיד עוקב אחרי המודל שנבחר במודלי ההכתבה."}}}},"The transcription service did not answer within %lld seconds. You can raise the cloud timeout in Model Settings.":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"The transcription service did not answer within %lld second. You can raise the cloud timeout in Model Settings."}},"other":{"stringUnit":{"state":"translated","value":"The transcription service did not answer within %lld seconds. You can raise the cloud timeout in Model Settings."}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"שירות התמלול לא ענה תוך שנייה אחת. אפשר להאריך את זמן ההמתנה לענן בהגדרות המודל."}},"two":{"stringUnit":{"state":"translated","value":"שירות התמלול לא ענה תוך שתי שניות. אפשר להאריך את זמן ההמתנה לענן בהגדרות המודל."}},"other":{"stringUnit":{"state":"translated","value":"שירות התמלול לא ענה תוך %lld שניות. אפשר להאריך את זמן ההמתנה לענן בהגדרות המודל."}}}}}}},"The voice used by the provider above. Each provider has its own set, so this list changes when you switch provider. Use Preview voice at the bottom to hear one before settling on it.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקול שבו משתמש הספק שנבחר. לכל ספק יש קולות אחרים, ולכן הרשימה משתנה בעת החלפת ספק. ניתן להשתמש בתצוגה המקדימה למטה כדי להאזין לקול לפני הבחירה."}}}},"The website '%@' is already configured in the '%@' power mode.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"האתר '%1$@' כבר מוגדר במצב העוצמה '%2$@'."}}}},"These options apply to the files you add next.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"האפשרויות חלות על הקבצים שיתווספו מעכשיו."}}}},"Thinking…":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חושב…"}}}},"This can happen due to an issue with the audio recording or insufficient system resources. Please try again, or restart the app.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדבר עלול לקרות בגלל בעיה בהקלטת השמע או מחסור במשאבי מערכת. יש לנסות שוב או להפעיל מחדש את היישום."}}}},"This file has no audio to transcribe.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין בקובץ הזה שמע לתמלול."}}}},"This file type is not supported. Add an audio or video file.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סוג הקובץ אינו נתמך. יש להוסיף קובץ שמע או וידאו."}}}},"This filler word is already in the list.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילת המילוי הזו כבר ברשימה."}}}},"This helps to improve the accuracy of transcription.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זה עוזר לשפר את דיוק התמלול."}}}},"This is an English-optimized model and only supports English transcription.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זהו מודל שמותאם לאנגלית ותומך בתמלול באנגלית בלבד."}}}},"This is how the selected voice sounds in Zerm.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כך נשמע הקול שנבחר ב-Zerm."}}}},"This key is also your dictation hotkey — pick a different one to avoid both firing.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקש זה משמש גם להכתבה — יש לבחור מקש אחר כדי למנוע הפעלה של שניהם."}}}},"This mode switches on whenever one of these apps is the one you are working in. Apps are matched exactly, so adding Mail here has no effect while you are in a browser reading webmail — use a website trigger for that.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המצב הזה מופעל בכל פעם שאחד מהיישומים האלה הוא היישום שבו עובדים. ההתאמה ליישומים מדויקת, ולכן הוספת Mail כאן לא תשפיע כשקוראים דואר אינטרנטי בדפדפן — לשם כך יש להשתמש בהפעלה לפי אתר."}}}},"This model needs more memory than this Mac has available":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל הזה דורש יותר זיכרון ממה שזמין ב-Mac הזה"}}}},"This model supports multiple languages. Select a specific language or auto-detect(if available)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל הזה תומך בכמה שפות. אפשר לבחור שפה מסוימת או זיהוי אוטומטי (אם זמין)"}}}},"This name is already used by a built-in model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השם הזה כבר משמש מודל מובנה"}}}},"This replaces your prompts, power modes, custom models, and dictionary with the contents of \"%@\". Only import files you trust.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעולה מחליפה את ההנחיות, מצבי העוצמה, המודלים המותאמים והמילון בתוכן של \"%@\". יש לייבא רק קבצים ממקור מהימן."}}}},"Timeout":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זמן המתנה מרבי"}}}},"Timeout duration":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"משך זמן ההמתנה"}}}},"Tip: Use ⌃⌘Space for emoji picker or paste an emoji.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טיפ: אפשר להשתמש ב-⌃⌘Space לפתיחת בוחר האמוג'י או להדביק אמוג'י."}}}},"Toggle":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"החלפה"}}}},"Toggle AI Enhancement":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלה או השבתה של שיפור AI"}}}},"Toggle Inspector":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגה או הסתרה של חלונית הפרטים"}}}},"Toggle Recorder":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלה או עצירה של המקליט"}}}},"Toggle Sidebar":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגה או הסתרה של סרגל הצד"}}}},"Toggle Zerm Recorder":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הפעלה או עצירה של המקליט של Zerm"}}}},"Total":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סך הכול"}}}},"Transcribe File":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלול קובץ"}}}},"Transcribing":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מתמלל"}}}},"Transcribing…":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מתמלל…"}}}},"Transcript Cleanup":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניקוי תמלולים"}}}},"Transcript Unavailable":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול אינו זמין"}}}},"Transcription":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלול"}}}},"Transcription Failed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול נכשל"}}}},"Transcription Failed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול נכשל: %@"}}}},"Transcription Failed: No model selected":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול נכשל: לא נבחר מודל"}}}},"Transcription Language":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שפת התמלול"}}}},"Transcription Model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל תמלול"}}}},"Transcription Models":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודלי תמלול"}}}},"Transcription Time":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זמן תמלול"}}}},"Transcription failed using SpeechAnalyzer.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול באמצעות SpeechAnalyzer נכשל."}}}},"Transcription failed: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול נכשל: %@"}}}},"Transcription failed: No model selected":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול נכשל: לא נבחר מודל"}}}},"Transcription history could not be saved":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן היה לשמור את היסטוריית התמלולים"}}}},"Transcription timed out after 120 seconds. The audio was kept — retry from History.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זמן התמלול עבר לאחר 120 שניות. השמע נשמר — אפשר לנסות שוב מההיסטוריה."}}}},"Transcription was cancelled. The audio was kept — retry from History.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול בוטל. השמע נשמר — אפשר לנסות שוב מההיסטוריה."}}}},"Transcription was interrupted (the file was still being written, or the 120s limit cancelled Whisper). The audio should still be in Recordings — retry from History.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התמלול הופסק (הקובץ עדיין נכתב, או שמגבלת 120 השניות ביטלה את Whisper). השמע אמור להישאר בהקלטות — אפשר לנסות שוב מההיסטוריה."}}}},"Transcripts shorter than this are pasted as-is, with no AI call — so they appear instantly and cost nothing. Raise it if short replies keep getting reworded; lower it if you want even brief phrases enhanced.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלולים קצרים מזה מודבקים כפי שהם, ללא פנייה ל-AI — כך הם מופיעים מיד ואינם עולים דבר. כדאי להגדיל את הערך אם תשובות קצרות מנוסחות מחדש שוב ושוב, ולהקטין אותו כדי שגם ביטויים קצרים ישופרו."}}}},"Translate to English":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תרגום לאנגלית"}}}},"Trigger Scenarios":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תרחישי הפעלה"}}}},"Trigger Words":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילות הפעלה"}}}},"Trigger key":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקש הפעלה"}}}},"Try It Out!":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"רוצים לנסות?"}}}},"Try a different search term":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נסו מונח חיפוש אחר"}}}},"Try again":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ניסיון חוזר"}}}},"Try another search term.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נסו מונח חיפוש אחר."}}}},"Try selecting a different model or redownloading the current model.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אפשר לבחור מודל אחר או להוריד מחדש את המודל הנוכחי."}}}},"Tuned for Hebrew: Auto-detect transcribes Hebrew and keeps English words. Choose English only for English-only dictation.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tuned for Hebrew: Auto-detect transcribes Hebrew and keeps English words. Choose English only for English-only dictation."}},"he":{"stringUnit":{"state":"translated","value":"מותאם לעברית: זיהוי אוטומטי מתמלל בעברית ושומר על מילים באנגלית. יש לבחור אנגלית רק להכתבה באנגלית בלבד."}}}},"Turn on for prompts that translate, answer or expand the text, such as writing an email. Otherwise Zerm discards a result that switches language or grows far longer than what you said, and keeps your original text.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יש להפעיל עבור הנחיות שמתרגמות, עונות או מרחיבות את הטקסט, למשל כתיבת אימייל. אחרת Zerm פוסל תוצאה שמחליפה שפה או ארוכה בהרבה ממה שאמרת, ושומר את הטקסט המקורי."}}}},"Turn on if this endpoint transcribes languages other than English. When on, Zerm offers a language picker and sends the selected language with each request; when off, no language is sent.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יש להפעיל אם נקודת הקצה מתמללת שפות נוספות מלבד אנגלית. כשהאפשרות פעילה, Zerm מציג בחירת שפה ושולח את השפה הנבחרת בכל בקשה. כשהיא כבויה, לא נשלחת שפה."}}}},"Turn this on if transcriptions with local models are taking longer than expected. Runs silent background transcription on app launch and wake to trigger optimization.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כדאי להפעיל אם תמלול במודלים מקומיים נמשך יותר מהצפוי. בעת הפעלת היישום ויציאה ממצב שינה מתבצע תמלול שקט ברקע כדי להפעיל את האופטימיזציה."}}}},"Turns on the shortcut that speaks whatever text you have selected, in any app. Useful for proofreading your own writing or getting through a long article without staring at it. Off means the shortcut does nothing.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מפעיל קיצור שמקריא את הטקסט שנבחר בכל יישום. שימושי להגהת כתיבה או להאזנה למאמר ארוך. כאשר האפשרות כבויה, הקיצור אינו פועל."}}}},"Two different tools. Word Replacements rewrite text after transcription — always exact, always applied, no AI needed. Vocabulary instead tells the model which unusual names and terms to expect, so it is more likely to hear them correctly in the first place.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שני כלים שונים. החלפות מילים משכתבות את הטקסט אחרי התמלול — תמיד במדויק, תמיד מוחלות וללא צורך ב-AI. אוצר המילים, לעומת זאת, מודיע למודל לאילו שמות ומונחים חריגים לצפות, כך שגדל הסיכוי שישמע אותם נכון מלכתחילה."}}}},"Unavailable":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא זמין"}}}},"Undo":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ביטול פעולה"}}}},"Unexpected response from the speech provider.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התקבלה תגובה לא צפויה מספק הדיבור."}}}},"Unknown":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ידוע"}}}},"Unknown Device":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התקן לא ידוע"}}}},"Unsupported provider":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק לא נתמך"}}}},"Update available":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עדכון זמין"}}}},"Update available: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עדכון זמין: %@"}}}},"Update check failed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בדיקת העדכונים נכשלה"}}}},"Update the word or phrase that should be automatically replaced.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עדכון המילה או הביטוי שיוחלפו אוטומטית."}}}},"Use AppleScript Paste":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שימוש בהדבקה באמצעות AppleScript"}}}},"Use Cloud":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Cloud"}},"he":{"stringUnit":{"state":"translated","value":"מעבר לענן"}}}},"Use System Template":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שימוש בתבנית המערכת"}}}},"Use for %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שימוש עבור %@"}}}},"Use global setting":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שימוש בהגדרה הכללית"}}}},"Use this model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שימוש במודל זה"}}}},"Use your Mac's default input":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שימוש בקלט ברירת המחדל של ה-Mac"}}}},"Used in Enhanced output only: Instant + Refine has no time to read the screen. Including on-screen text adds it to enhancement requests. Zerm does not save that captured text to disk, but the request can send it to your configured enhancement provider. Choose an on-device provider to keep it on your Mac.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"פועל רק בפלט משופר: למצב מיידי + שיפור אין זמן לקרוא את המסך. הוספת טקסט שמופיע על המסך כוללת אותו בבקשות שיפור. Zerm אינו שומר את הטקסט שנקלט בדיסק, אך הבקשה יכולה לשלוח אותו לספק השיפור שהוגדר. כדי להשאיר את הטקסט ב-Mac, יש לבחור ספק שפועל במכשיר."}}}},"User Message":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הודעת משתמש"}}}},"Uses Dictionary":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses Dictionary"}},"he":{"stringUnit":{"state":"translated","value":"משתמש במילון"}}}},"Uses VoiceProcessingIO for acoustic echo cancellation and automatic gain control. Helpful in noisy rooms or when speakers are on. Restart recording after changing.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שימוש ב-VoiceProcessingIO לביטול הד אקוסטי ולבקרת הגבר אוטומטית. שימושי בחדרים רועשים או כשהרמקולים פועלים. יש להתחיל הקלטה חדשה לאחר שינוי."}}}},"Uses the native Apple Speech framework for transcription. Requires macOS 26":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"משתמש במנגנון זיהוי הדיבור המובנה של Apple לתמלול. דורש macOS 26"}}}},"Using: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בשימוש: %@"}}}},"Validation Errors":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שגיאות אימות"}}}},"Verification failed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"האימות נכשל"}}}},"Verification failed. Edit or verify the endpoint before using this model.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"האימות נכשל. יש לערוך או לאמת את נקודת הקצה לפני השימוש במודל."}}}},"Verify":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות"}}}},"Verify Endpoint":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות נקודת הקצה"}}}},"Verify and Add":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות והוספה"}}}},"Verify and Save":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות ושמירה"}}}},"Verify and Update":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות ועדכון"}}}},"Verifying...":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מאמת..."}}}},"Verifying…":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מאמת…"}}}},"Version Mismatch":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אי-התאמה בגרסה"}}}},"View Transcript":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגת התמלול"}}}},"View details":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגת פרטים"}}}},"Vocabulary":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אוצר מילים"}}}},"Vocabulary Words (%lld)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילים באוצר המילים (%lld)"}}}},"Voice":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קול"}}}},"Voice Activity Detection (VAD)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זיהוי פעילות קולית (VAD)"}}}},"Voice provider":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק קול"}}}},"WPM":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילים/דקה"}}}},"Wait for the AI, then paste once.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המתנה ל-AI ולאחר מכן הדבקה פעם אחת."}}}},"Waiting":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ממתין"}}}},"We'll download the optimized model to get you started.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נוריד את המודל המותאם כדי שאפשר יהיה להתחיל."}}}},"WebVTT Subtitles (.vtt)":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתוביות WebVTT · VTT"}}}},"Websites":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אתרים"}}}},"Welcome to the Future of Typing":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ברוכים הבאים לעתיד ההקלדה"}}}},"What happens once the wait runs out. Fail immediately pastes the unenhanced transcript, so you always get your words. Retry tries again, up to three attempts — better on a flaky connection, but you wait longer before anything appears.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מה קורה כשזמן ההמתנה מסתיים. כישלון מיידי מדביק את התמלול ללא שיפור, כך שהמילים תמיד מתקבלות. ניסיון חוזר מנסה שוב, עד שלושה ניסיונות — עדיף בחיבור לא יציב, אך ההמתנה עד שמשהו מופיע ארוכה יותר."}}}},"What the AI is told to do with each transcript — \"rewrite this as a short, polite email\", \"keep my wording but fix the punctuation\". Write it as directions to a person; the transcript is handed to the model along with this text.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מה ה-AI מתבקש לעשות עם כל תמלול — \"לנסח מחדש כאימייל קצר ומנומס\", \"לשמור על הניסוח שלי אבל לתקן את הפיסוק\". כדאי לכתוב זאת כהוראות לאדם; התמלול מועבר למודל יחד עם הטקסט הזה."}}}},"Where the recorder appears while you dictate. Notch sits in the menu bar area at the top of the screen, around the camera housing on Macs that have one. Mini is a small floating pill you can drag anywhere.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המקום שבו המקליט מופיע בזמן הכתבה. מגרעת מופיעה באזור שורת התפריטים סביב המצלמה במחשבי Mac מתאימים; מיני הוא חלון צף קטן שאפשר לגרור לכל מקום."}}}},"Whether this Power Mode pastes instantly or uses AI enhancement. \"Use global setting\" follows the Output setting in Enhancement.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"האם מצב העוצמה הזה מדביק מיד או משתמש בשיפור באמצעות AI. \"שימוש בהגדרה הכללית\" עוקב אחרי הגדרת הפלט במסך השיפור."}}}},"Which connected service enhances transcripts in this mode. Handy for keeping work text on a local provider while using a cloud one elsewhere. Only providers you have already connected appear here.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השירות המחובר שמשפר תמלולים במצב הזה. שימושי כדי להשאיר טקסט עבודה אצל ספק מקומי ולהשתמש בספק ענן במקומות אחרים. מוצגים כאן רק ספקים שכבר חוברו."}}}},"Which model this provider should use for enhancement. Faster models keep the pause after you stop speaking short; larger ones follow long or fussy prompts more reliably.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל שבו הספק ישתמש לשיפור. מודלים מהירים יותר מקצרים את ההמתנה אחרי סיום הדיבור; מודלים גדולים יותר מצייתים בצורה אמינה יותר להנחיות ארוכות או מדוקדקות."}}}},"Whisper Large v3 Turbo fine-tuned on Hebrew speech by ivrit.ai. Transcribes in Hebrew unless you choose English":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whisper Large v3 Turbo fine-tuned on Hebrew speech by ivrit.ai. Transcribes in Hebrew unless you choose English"}},"he":{"stringUnit":{"state":"translated","value":"Whisper Large v3 Turbo שאומן על דיבור בעברית על ידי ivrit.ai. מתמלל בעברית, אלא אם נבחרה אנגלית"}}}},"Whisper Large v3 Turbo model with Groq's lightning-speed inference":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל Whisper Large v3 Turbo עם ההרצה המהירה במיוחד של Groq"}}}},"Who runs the AI that cleans up your transcripts. The hosted services need an API key and send your text to their servers; Ollama and the on-device option keep everything on this Mac. Transcription is configured separately — this only affects enhancement.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השירות שמריץ את ה-AI שמנקה את התמלולים. שירותים מתארחים דורשים מפתח API ושולחים את הטקסט לשרתים שלהם; Ollama והאפשרות שפועלת במכשיר משאירים הכול ב-Mac הזה. התמלול מוגדר בנפרד — הגדרה זו משפיעה רק על השיפור."}}}},"Who synthesises the speech. Kokoro runs entirely on your Mac — nothing leaves the machine and it works offline, after a one-off model download. The cloud providers sound more natural but send the selected text to their servers and need an API key.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השירות שמפיק את הדיבור. Kokoro פועל כולו על ה-Mac — דבר אינו יוצא מהמכשיר והוא פועל ללא חיבור לרשת לאחר הורדת המודל. ספקי ענן נשמעים טבעיים יותר, אך שולחים את הטקסט הנבחר לשרתים שלהם ודורשים מפתח API."}}}},"With":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"החלפה"}}}},"Word Replacement":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"החלפת מילים"}}}},"Word Replacements":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"החלפות מילים"}}}},"Words":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילים"}}}},"Words Dictated":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילים שהוכתבו"}}}},"Words Per Minute":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילים לדקה"}}}},"Words Read Aloud":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילים שהוקראו"}}}},"Words per minute":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מילים לדקה"}}}},"Works Everywhere on Mac with a click":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עובד בכל מקום ב-Mac בלחיצה"}}}},"Writes a detailed record of what Zerm is doing to a file on this Mac. Turn it on only while reproducing a problem you want to report, then turn it off — the log grows quickly and can contain the text of your transcriptions.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתיבת תיעוד מפורט של פעולות Zerm לקובץ ב-Mac זה. יש להפעיל רק בזמן שחזור בעיה לדיווח ואז לכבות; היומן גדל במהירות ועלול להכיל את טקסט התמלולים."}}}},"Writes a single file containing your settings, prompts, Power Modes, dictionary and custom models. Keep it as a backup or use it to set up Zerm the same way on another Mac. API keys are not included.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתיבת קובץ יחיד שמכיל את ההגדרות, ההנחיות, מצבי העוצמה, המילון והמודלים המותאמים. אפשר לשמור כגיבוי או להשתמש בו להגדרת Zerm ב-Mac אחר. מפתחות API אינם נכללים."}}}},"You can only customize the trigger words for system prompts.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בהנחיות מערכת אפשר לשנות רק את מילות ההפעלה."}}}},"You saved %@ with Zerm":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חסכת %@ עם Zerm"}}}},"You saved %@ with Zerm in the last 12 months":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חסכת %@ עם Zerm ב-12 החודשים האחרונים"}}}},"You saved %@ with Zerm in the last 30 days":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חסכת %@ עם Zerm ב-30 הימים האחרונים"}}}},"You saved %@ with Zerm in the last 7 days":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חסכת %@ עם Zerm ב-7 הימים האחרונים"}}}},"You'll see the introduction screens again the next time you launch the app.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מסכי ההיכרות יוצגו שוב בהפעלה הבאה של היישום."}}}},"You're up to date":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm מעודכן לגרסה האחרונה"}}}},"Your Shortcut":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קיצור הדרך שלך"}}}},"Your Vibe-Coding Assistant":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עוזר ה-Vibe Coding שלך"}}}},"Your Writing Assistant":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עוזר הכתיבה שלך"}}}},"Your Zerm journey starts with your first recording.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המסע שלך עם Zerm מתחיל בהקלטה הראשונה."}}}},"Your ranked list of microphones. Number 1 is used whenever it is connected, otherwise Zerm tries number 2, and so on. Use the up and down arrows to reorder, and the red minus to drop a device back to the available list.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"רשימת המיקרופונים המדורגת שלך. מספר 1 משמש כשהוא מחובר, אחרת Zerm מנסה את מספר 2 וכן הלאה. החצים משנים את הסדר והמינוס האדום מחזיר התקן לרשימת הזמינים."}}}},"Your settings have been successfully exported to %@.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההגדרות יוצאו בהצלחה אל %@."}}}},"Your transcription history will appear here":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"היסטוריית התמלולים שלך תופיע כאן"}}}},"Zerm Onboarding":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"היכרות ראשונית עם Zerm"}}}},"Zerm can read on-screen text when Screen Context is enabled. Zerm does not save that captured text to disk, but enhancement requests can send it to your configured enhancement provider. Choose an on-device provider to keep it on your Mac. After enabling Screen Recording, fully quit and reopen Zerm if this check stays red.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm יכול לקרוא טקסט שמופיע על המסך כאשר ״הקשר מהמסך״ מופעל. Zerm אינו שומר את הטקסט שנקלט בדיסק, אך בקשות שיפור יכולות לשלוח אותו לספק השיפור שהוגדר. כדי להשאיר את הטקסט ב-Mac, יש לבחור ספק שפועל במכשיר. לאחר הפעלת הקלטת מסך, אם הבדיקה נשארת אדומה יש לסגור את Zerm לחלוטין ולפתוח אותו מחדש."}}}},"Zerm cannot initialize its storage system. The app cannot continue.\n\nPlease try reinstalling the app or contact support if the issue persists.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm אינו יכול לאתחל את מערכת האחסון שלו, והיישום אינו יכול להמשיך.\n\nיש לנסות להתקין מחדש את היישום או לפנות לתמיכה אם הבעיה נמשכת."}}}},"Zerm could not replace the original text automatically.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm לא הצליחה להחליף את הטקסט המקורי באופן אוטומטי."}}}},"Zerm couldn't access its storage location. Your transcriptions will not be saved between sessions.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ל-Zerm אין גישה למיקום האחסון שלו. התמלולים לא יישמרו בין הפעלות."}}}},"Zerm kept the original text to avoid editing the wrong content.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm שמר על הטקסט המקורי כדי להימנע מעריכת תוכן שגוי."}}}},"Zerm recorder dismissed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המקליט של Zerm נסגר"}}}},"Zerm recorder toggled":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מצב המקליט של Zerm השתנה"}}}},"Zerm recovered from a stuck state — try again":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm התאושש ממצב תקוע — יש לנסות שוב"}}}},"Zerm requires the following permissions to function properly":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm זקוק להרשאות הבאות כדי לפעול כראוי"}}}},"Zerm uses Accessibility permissions to paste the transcribed text directly into other applications at your cursor's position. This allows for a seamless dictation experience across your Mac. After enabling Zerm in System Settings, use the refresh button — if it stays red, fully quit Zerm (Cmd+Q) and reopen.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm משתמש בהרשאת נגישות כדי להדביק טקסט מתומלל ישירות ביישומים אחרים במיקום הסמן. לאחר הפעלת Zerm בהגדרות המערכת, יש להשתמש בכפתור הרענון; אם המצב נשאר אדום, יש לסגור את Zerm לחלוטין (Cmd+Q) ולפתוח מחדש."}}}},"Zerm — Transcription History":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Zerm — היסטוריית תמלולים"}}}},"audio_cleanup_delete_confirmation %lld %@":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"This will delete %1$lld audio file (%2$@)."}},"other":{"stringUnit":{"state":"translated","value":"This will delete %1$lld audio files (%2$@)."}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"פעולה זו תמחק קובץ שמע אחד (%2$@)."}},"other":{"stringUnit":{"state":"translated","value":"פעולה זו תמחק %1$lld קובצי שמע (%2$@)."}},"two":{"stringUnit":{"state":"translated","value":"פעולה זו תמחק שני קובצי שמע (%2$@)."}}}}}}},"audio_cleanup_delete_files %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Delete %lld File"}},"other":{"stringUnit":{"state":"translated","value":"Delete %lld Files"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"מחיקת קובץ אחד"}},"other":{"stringUnit":{"state":"translated","value":"מחיקת %lld קבצים"}},"two":{"stringUnit":{"state":"translated","value":"מחיקת שני קבצים"}}}}}}},"audio_cleanup_deleted_files %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Deleted %lld audio file."}},"other":{"stringUnit":{"state":"translated","value":"Deleted %lld audio files."}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"נמחק קובץ שמע אחד."}},"other":{"stringUnit":{"state":"translated","value":"נמחקו %lld קובצי שמע."}},"two":{"stringUnit":{"state":"translated","value":"נמחקו שני קובצי שמע."}}}}}}},"audio_cleanup_result_counts %lld %lld":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion complete. Deleted: %1$lld. Failed: %2$lld."}},"he":{"stringUnit":{"state":"translated","value":"המחיקה הושלמה. נמחקו: %1$lld. נכשלו: %2$lld."}}}},"download failed":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ההורדה נכשלה"}}}},"e.g. Prakash, Zerm":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לדוגמה: Prakash, Zerm"}}}},"e.g. gemini-3.1-pro-preview, gpt-oss-120b":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לדוגמה gemini-3.1-pro-preview, gpt-oss-120b"}}}},"e.g. https://api.openai.com/v1/chat/completions":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לדוגמה https://api.openai.com/v1/chat/completions"}}}},"e.g. my email, my mail":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לדוגמה: המייל שלי"}}}},"e.g. prakashjoshipax@gmail.com":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לדוגמה: prakashjoshipax@gmail.com"}}}},"file_transcription_speakers %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld speaker"}},"other":{"stringUnit":{"state":"translated","value":"%lld speakers"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"דובר אחד"}},"two":{"stringUnit":{"state":"translated","value":"שני דוברים"}},"other":{"stringUnit":{"state":"translated","value":"%lld דוברים"}}}}}}},"history_delete_confirmation %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"This action cannot be undone. Are you sure you want to delete %lld item?"}},"other":{"stringUnit":{"state":"translated","value":"This action cannot be undone. Are you sure you want to delete %lld items?"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"לא ניתן לבטל פעולה זו. למחוק פריט אחד?"}},"two":{"stringUnit":{"state":"translated","value":"לא ניתן לבטל פעולה זו. למחוק שני פריטים?"}},"other":{"stringUnit":{"state":"translated","value":"לא ניתן לבטל פעולה זו. למחוק %lld פריטים?"}}}}}}},"history_selected_count %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld selected"}},"other":{"stringUnit":{"state":"translated","value":"%lld selected"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"פריט אחד נבחר"}},"two":{"stringUnit":{"state":"translated","value":"שני פריטים נבחרו"}},"other":{"stringUnit":{"state":"translated","value":"%lld פריטים נבחרו"}}}}}}},"https://api.example.com/v1/audio/transcriptions":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"https://api.example.com/v1/audio/transcriptions"}}}},"macOS 26+":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"macOS 26 ומעלה"}}}},"ms":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אלפיות השנייה"}}}},"my website link":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הקישור לאתר שלי"}}}},"no network connection":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אין חיבור לרשת"}}}},"power_mode_apps %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld App"}},"other":{"stringUnit":{"state":"translated","value":"%lld Apps"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"יישום אחד"}},"other":{"stringUnit":{"state":"translated","value":"%lld יישומים"}},"two":{"stringUnit":{"state":"translated","value":"שני יישומים"}}}}}}},"power_mode_websites %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld Website"}},"other":{"stringUnit":{"state":"translated","value":"%lld Websites"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"אתר אחד"}},"other":{"stringUnit":{"state":"translated","value":"%lld אתרים"}},"two":{"stringUnit":{"state":"translated","value":"שני אתרים"}}}}}}},"speed_factor %@":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@×"}},"he":{"stringUnit":{"state":"translated","value":"פי %@"}}}},"start":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"התחלה"}}}},"stop":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עצירה"}}}},"the AI returned no text":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ה-AI לא החזיר טקסט"}}}},"the provider had a server error":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אירעה שגיאת שרת אצל הספק"}}}},"the provider's rate limit was reached":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הגעת למגבלת הבקשות של הספק"}}}},"usage_across_sessions %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"across %lld session"}},"other":{"stringUnit":{"state":"translated","value":"across %lld sessions"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"בהקלטה אחת"}},"two":{"stringUnit":{"state":"translated","value":"בשתי הקלטות"}},"other":{"stringUnit":{"state":"translated","value":"ב-%lld הקלטות"}}}}}}},"usage_days %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld day"}},"other":{"stringUnit":{"state":"translated","value":"%lld days"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"יום אחד"}},"two":{"stringUnit":{"state":"translated","value":"יומיים"}},"other":{"stringUnit":{"state":"translated","value":"%lld ימים"}}}}}}},"usage_longest_streak %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"All-time best: %lld day"}},"other":{"stringUnit":{"state":"translated","value":"All-time best: %lld days"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"שיא כל הזמנים: יום אחד"}},"two":{"stringUnit":{"state":"translated","value":"שיא כל הזמנים: יומיים"}},"other":{"stringUnit":{"state":"translated","value":"שיא כל הזמנים: %lld ימים"}}}}}}},"usage_transcripts %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld transcript"}},"other":{"stringUnit":{"state":"translated","value":"%lld transcripts"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"תמלול אחד"}},"two":{"stringUnit":{"state":"translated","value":"שני תמלולים"}},"other":{"stringUnit":{"state":"translated","value":"%lld תמלולים"}}}}}}},"usage_words %lld":{"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld word"}},"other":{"stringUnit":{"state":"translated","value":"%lld words"}}}}},"he":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"מילה אחת"}},"two":{"stringUnit":{"state":"translated","value":"שתי מילים"}},"other":{"stringUnit":{"state":"translated","value":"%lld מילים"}}}}}}},"v%@ available":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"גרסה %@ זמינה"}}}},"whisper-1":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"whisper-1"}}}},"xAI's Grok speech-to-text with real-time streaming and batch transcription. Does not support Hebrew.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המרת דיבור לטקסט של Grok מבית xAI, בזמן אמת או לאחר ההקלטה. אינו תומך בעברית."}}}},"your-api-key":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מפתח-ה-API-שלך"}}}},"⌘":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"⌘"}}}},"➕":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"➕"}}}}},"version":"1.0"}
