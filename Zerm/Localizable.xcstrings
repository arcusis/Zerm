lated","value":"Import Local Model…"}},"he":{"stringUnit":{"state":"translated","value":"ייבוא מודל מקומי…"}}}},"Add a custom fine-tuned whisper model to use with Zerm. Select the downloaded .bin file.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add a custom fine-tuned whisper model to use with Zerm. Select the downloaded .bin file."}},"he":{"stringUnit":{"state":"translated","value":"הוספת מודל Whisper מותאם לשימוש ב-Zerm. יש לבחור את קובץ ה-bin שהורד."}}}},"Read more about custom local models":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read more about custom local models"}},"he":{"stringUnit":{"state":"translated","value":"מידע נוסף על מודלים מקומיים מותאמים"}}}},"All providers":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"All providers"}},"he":{"stringUnit":{"state":"translated","value":"כל הספקים"}}}},"Only OpenAI-compatible transcription APIs are supported.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only OpenAI-compatible transcription APIs are supported."}},"he":{"stringUnit":{"state":"translated","value":"נתמכים רק ממשקי תמלול שתואמים ל-OpenAI."}}}},"Local models don't work reliably on Intel Macs":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local models don't work reliably on Intel Macs"}},"he":{"stringUnit":{"state":"translated","value":"מודלים מקומיים אינם פועלים באופן אמין במחשבי Mac עם מעבד Intel"}}}},"Use Cloud":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Cloud"}},"he":{"stringUnit":{"state":"translated","value":"מעבר לענן"}}}},"%@ — recommendations are tuned for this Mac; models that need more memory are marked or unavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ — recommendations are tuned for this Mac; models that need more memory are marked or unavailable"}},"he":{"stringUnit":{"state":"translated","value":"%@ — ההמלצות מותאמות ל-Mac הזה; מודלים שדורשים יותר זיכרון מסומנים או אינם זמינים"}}}},"Select a Whisper ggml .bin model":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a Whisper ggml .bin model"}},"he":{"stringUnit":{"state":"translated","value":"בחירת מודל Whisper בתבנית ggml (קובץ bin)"}}}},"Downloading...":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Downloading..."}},"he":{"stringUnit":{"state":"translated","value":"מוריד..."}}}},"Retry Download":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry Download"}},"he":{"stringUnit":{"state":"translated","value":"ניסיון הורדה חוזר"}}}},"Download failed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Download failed"}},"he":{"stringUnit":{"state":"translated","value":"ההורדה נכשלה"}}}},"Tuned for Hebrew: Auto-detect transcribes Hebrew and keeps English words. Choose English only for English-only dictation.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tuned for Hebrew: Auto-detect transcribes Hebrew and keeps English words. Choose English only for English-only dictation."}},"he":{"stringUnit":{"state":"translated","value":"מותאם לעברית: זיהוי אוטומטי מתמלל בעברית ושומר על מילים באנגלית. יש לבחור אנגלית רק להכתבה באנגלית בלבד."}}}},"NVIDIA's newest English model: the most accurate English transcription on this list, with punctuation and capitalization. Apple Silicon only":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"NVIDIA's newest English model: the most accurate English transcription on this list, with punctuation and capitalization. Apple Silicon only"}},"he":{"stringUnit":{"state":"translated","value":"מודל האנגלית החדש של NVIDIA: התמלול המדויק ביותר לאנגלית ברשימה, כולל פיסוק ואותיות רישיות. ל-Apple Silicon בלבד"}}}},"A small, very fast English model that leaves memory free on 8 GB Macs. Apple Silicon only":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"A small, very fast English model that leaves memory free on 8 GB Macs. Apple Silicon only"}},"he":{"stringUnit":{"state":"translated","value":"מודל אנגלית קטן ומהיר מאוד שמשאיר זיכרון פנוי במחשבי Mac עם 8 GB. ל-Apple Silicon בלבד"}}}},"Whisper Large v3 Turbo fine-tuned on Hebrew speech by ivrit.ai. Transcribes in Hebrew unless you choose English":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whisper Large v3 Turbo fine-tuned on Hebrew speech by ivrit.ai. Transcribes in Hebrew unless you choose English"}},"he":{"stringUnit":{"state":"translated","value":"Whisper Large v3 Turbo שאומן על דיבור בעברית על ידי ivrit.ai. מתמלל בעברית, אלא אם נבחרה אנגלית"}}}},"The most accurate Hebrew model, fine-tuned by ivrit.ai. Slower and needs a Mac with 24 GB of memory or more":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The most accurate Hebrew model, fine-tuned by ivrit.ai. Slower and needs a Mac with 24 GB of memory or more"}},"he":{"stringUnit":{"state":"translated","value":"מודל העברית המדויק ביותר, שאומן על ידי ivrit.ai. איטי יותר ודורש Mac עם 24 GB זיכרון לפחות"}}}},"Parakeet Unified is not downloaded. Download it again in Models.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Parakeet Unified is not downloaded. Download it again in Models."}},"he":{"stringUnit":{"state":"translated","value":"Parakeet Unified לא הורד. יש להוריד אותו שוב במסך המודלים."}}}},"The downloaded file did not match its published checksum and was discarded. Try again.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The downloaded file did not match its published checksum and was discarded. Try again."}},"he":{"stringUnit":{"state":"translated","value":"הקובץ שהורד לא תאם לסכום הביקורת שפורסם ולכן נמחק. יש לנסות שוב."}}}},"Parakeet needs a one-time update download. Connect to the internet and try again.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Parakeet needs a one-time update download. Connect to the internet and try again."}},"he":{"stringUnit":{"state":"translated","value":"Parakeet צריך הורדת עדכון חד־פעמית. יש להתחבר לאינטרנט ולנסות שוב."}}}},"The model provider is not supported by this service.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק המודל אינו נתמך בשירות הזה."}}}},"API key for this service is missing. Please configure it in the settings.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"חסר מפתח API לשירות הזה. יש להגדיר אותו בהגדרות."}}}},"The provided API key is invalid.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מפתח ה-API שהוזן אינו תקין."}}}},"The audio file to transcribe could not be found.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קובץ השמע לתמלול לא נמצא."}}}},"The API request failed with status code %lld: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"בקשת ה-API נכשלה עם קוד סטטוס %1$lld: %2$@"}}}},"A network error occurred: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אירעה שגיאת רשת: %@"}}}},"The API returned an empty or invalid response.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ה-API החזיר תשובה ריקה או לא תקינה."}}}},"Failed to encode the request body.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קידוד גוף הבקשה נכשל."}}}},"API key is missing or empty.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מפתח ה-API חסר או ריק."}}}},"The endpoint URL is not valid.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתובת נקודת הקצה אינה תקינה."}}}},"The endpoint rejected the API key (HTTP 401/403). Check the key and that it has access to transcription.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה דחתה את מפתח ה-API (HTTP 401/403). יש לבדוק את המפתח ושיש לו הרשאה לתמלול."}}}},"Nothing answered at this URL (HTTP 404/405). Zerm posts audio directly to it, so use the full transcription endpoint, usually ending in /v1/audio/transcriptions.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אף שירות לא ענה בכתובת הזו (HTTP 404/405). Zerm שולח את השמע ישירות אליה, לכן יש להזין את כתובת התמלול המלאה, שבדרך כלל מסתיימת ב-/v1/audio/transcriptions."}}}},"The endpoint does not accept multipart audio uploads (HTTP 415). It may not be OpenAI-compatible.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה לא מקבלת העלאת שמע מסוג multipart (HTTP 415). ייתכן שהיא אינה תואמת OpenAI."}}}},"The endpoint rejected the request. Check the model name and language. Details: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה דחתה את הבקשה. יש לבדוק את שם המודל ואת השפה. פרטים: %@"}}}},"The endpoint is rate limiting requests (HTTP 429). Try again shortly.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה מגבילה את קצב הבקשות (HTTP 429). כדאי לנסות שוב בעוד רגע."}}}},"The endpoint had a server error (HTTP %lld). Try again later.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אירעה שגיאת שרת בנקודת הקצה (HTTP %lld). כדאי לנסות שוב מאוחר יותר."}}}},"The endpoint answered, but not with a transcription. Expected JSON with a \"text\" field or plain text.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת הקצה ענתה, אבל לא עם תמלול. הציפייה היא ל-JSON עם שדה \"text\" או לטקסט רגיל."}}}},"Could not reach the endpoint: %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן להתחבר לנקודת הקצה: %@"}}}},"OpenAI's current speech-to-text model with prompt and keyword support":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל המרת הדיבור לטקסט העדכני של OpenAI, עם תמיכה בהנחיה ובמילות מפתח"}}}},"Whisper Large v3 Turbo model with Groq's lightning-speed inference":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל Whisper Large v3 Turbo עם ההרצה המהירה במיוחד של Groq"}}}},"Full Whisper Large v3 on Groq, slower than Turbo and slightly more accurate":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"Whisper Large v3 המלא ב-Groq, איטי יותר מ-Turbo ומדויק מעט יותר"}}}},"Deepgram's fast Nova 3 model. Auto-detect covers ten major languages; choose Hebrew explicitly.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל Nova 3 המהיר של Deepgram. זיהוי אוטומטי מכסה עשר שפות מרכזיות, לכן לעברית יש לבחור בה במפורש."}}}},"Specialized English-only medical transcription model optimized for clinical environments":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל ייעודי לתמלול רפואי באנגלית בלבד, מותאם לסביבה קלינית"}}}},"ElevenLabs' Scribe V2 model for the most accurate transcription":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל Scribe V2 של ElevenLabs לתמלול מדויק במיוחד"}}}},"Mistral's low-cost transcription model for 13 major languages. Does not support Hebrew.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל התמלול החסכוני של Mistral ל-13 שפות מרכזיות. אינו תומך בעברית."}}}},"xAI's Grok speech-to-text with real-time streaming and batch transcription. Does not support Hebrew.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המרת דיבור לטקסט של Grok מבית xAI, בזמן אמת או לאחר ההקלטה. אינו תומך בעברית."}}}},"Soniox transcription model v5 with high accuracy and automatic switching between languages, including Hebrew and English":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל התמלול v5 של Soniox, מדויק מאוד ועובר אוטומטית בין שפות, כולל עברית ואנגלית"}}}},"AssemblyAI's flagship model with native code-switching, including Hebrew and English":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל הדגל של AssemblyAI, עם מעבר מובנה בין שפות, כולל עברית ואנגלית"}}}},"AssemblyAI's previous-generation model with broad language coverage":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל הדור הקודם של AssemblyAI, עם כיסוי רחב של שפות"}}}},"Speechmatics enhanced accuracy transcription with real-time streaming and 50+ language support":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמלול בדיוק משופר של Speechmatics, בזמן אמת ובלמעלה מ-50 שפות"}}}},"Gladia's Solaria model for about 100 languages, including Hebrew, with automatic language switching":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל Solaria של Gladia לכ-100 שפות, כולל עברית, עם מעבר אוטומטי בין שפות"}}}},"Name cannot be empty":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השם לא יכול להיות ריק"}}}},"Display name cannot be empty":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שם התצוגה לא יכול להיות ריק"}}}},"API endpoint cannot be empty":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתובת נקודת הקצה לא יכולה להיות ריקה"}}}},"API endpoint must be a valid http or https URL":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כתובת נקודת הקצה חייבת להיות כתובת http או https תקינה"}}}},"API key cannot be empty":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מפתח ה-API לא יכול להיות ריק"}}}},"Model name cannot be empty":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שם המודל לא יכול להיות ריק"}}}},"This name is already used by a built-in model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"השם הזה כבר משמש מודל מובנה"}}}},"A model with this name already exists":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כבר קיים מודל בשם הזה"}}}},"Output Format":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"סגנון הפלט"}}}},"Cloud timeout":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"זמן המתנה לענן"}}}},"How long to wait for a cloud model to return a transcript before giving up. Long recordings and files automatically get more time. Does not affect local models or live streaming.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"כמה זמן לחכות לתמלול ממודל ענן לפני שמוותרים. הקלטות וקבצים ארוכים מקבלים אוטומטית יותר זמן. לא משפיע על מודלים מקומיים או על תמלול בזמן אמת."}}}},"Example text that shows the spelling, punctuation and style you want. The selected model receives it with every transcription in the current language, and each language keeps its own text. Models imitate examples and ignore instructions, so write sample output, not commands. Rewriting and cleanup belong in Enhancement.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"טקסט לדוגמה שמראה את הכתיב, הפיסוק והסגנון הרצויים. המודל הנבחר מקבל אותו בכל תמלול בשפה הנוכחית, ולכל שפה יש טקסט משלה. מודלים מחקים דוגמאות ומתעלמים מהוראות, לכן כדאי לכתוב דוגמת פלט ולא פקודות. ניסוח מחדש וניקוי הטקסט שייכים לשיפור."}}}},"Add Model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הוספת מודל"}}}},"Edit Model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עריכת מודל"}}}},"Add Custom Model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הוספת מודל מותאם אישית"}}}},"Edit Custom Model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"עריכת מודל מותאם אישית"}}}},"Only OpenAI-compatible transcription APIs are supported. Zerm sends a one-second test recording to verify the endpoint before saving.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נתמכים רק ממשקי תמלול שתואמים OpenAI. לפני השמירה Zerm שולח הקלטת בדיקה של שנייה אחת כדי לאמת את נקודת הקצה."}}}},"Display Name":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שם תצוגה"}}}},"API Endpoint":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת קצה של API"}}}},"API Key":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מפתח API"}}}},"Model Name":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שם המודל"}}}},"My Custom Model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"המודל שלי"}}}},"Suggested":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצעות"}}}},"Multilingual Model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל רב-לשוני"}}}},"Turn on if this endpoint transcribes languages other than English. When on, Zerm offers a language picker and sends the selected language with each request; when off, no language is sent.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"יש להפעיל אם נקודת הקצה מתמללת שפות נוספות מלבד אנגלית. כשהאפשרות פעילה, Zerm מציג בחירת שפה ושולח את השפה הנבחרת בכל בקשה. כשהיא כבויה, לא נשלחת שפה."}}}},"Validation Errors":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שגיאות אימות"}}}},"Custom endpoint":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"נקודת קצה מותאמת אישית"}}}},"Preset":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"הגדרה מוכנה"}}}},"Get an API key and model list from %@":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"קבלת מפתח API ורשימת מודלים מ-%@"}}}},"Verifying...":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מאמת..."}}}},"Verify and Add":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות והוספה"}}}},"Verify and Update":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"אימות ועדכון"}}}},"Custom transcription model":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"מודל תמלול מותאם אישית"}}}},"Failed to securely save API Key to Keychain. Please check your system settings or try again.":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"שמירת מפתח ה-API במחזיק המפתחות נכשלה. יש לבדוק את הגדרות המערכת או לנסות שוב."}}}},"Custom Provider":{"localizations":{"he":{"stringUnit":{"state":"translated","value":"ספק מותאם אישית"}}}},"OpenAI Compatible":{"localizations":{"he":{